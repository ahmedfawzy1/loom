# CMS Postgres. `pnpm infra:up` starts this on 5435 (compose.dev.yaml), its own database.
CMS_DATABASE_URL="postgresql://postgres:password@localhost:5435/loom?schema=public"

# Local only: `pnpm db:seed` makes this person an Admin with this password, so there is someone to
# sign in as. `pnpm db:seed:demo` signs in with them too. Never run the seed in production.
CMS_SEED_ADMIN_EMAIL="admin@example.com"
CMS_SEED_ADMIN_PASSWORD="loom-local-admin"

# Where the admin app is served, for the link `pnpm admin:invite` prints. Pass --url to override.
CMS_ADMIN_URL="http://localhost:3000"
