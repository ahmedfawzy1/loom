{
  "name": "@loom/dto",
  "version": "1.0.0",
  "private": true,
  "main": "dist/dtos/index.js",
  "types": "dist/dtos/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dtos/index.d.ts",
      "default": "./dist/dtos/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "default": "./dist/models/index.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text/index.d.ts",
      "import": "./dist/esm/rich-text/index.js",
      "default": "./dist/rich-text/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "constants": [
        "./dist/constants/index.d.ts"
      ],
      "models": [
        "./dist/models/index.d.ts"
      ],
      "rich-text": [
        "./dist/rich-text/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "pnpm build",
    "build": "tsc && tsc -p tsconfig.esm.json",
    "dev": "tsc --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@loom/database": "workspace:^",
    "@tiptap/core": "catalog:tiptap",
    "@tiptap/extension-subscript": "catalog:tiptap",
    "@tiptap/extension-superscript": "catalog:tiptap",
    "@tiptap/extension-table": "catalog:tiptap",
    "@tiptap/pm": "catalog:tiptap",
    "@tiptap/starter-kit": "catalog:tiptap",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "~0.2.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "catalog:"
  }
}
