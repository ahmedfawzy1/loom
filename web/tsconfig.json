{
  "extends": "tsconfig/next",
  "compilerOptions": {
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@loom-web/*": ["*"]
    },
    "strictNullChecks": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "types": ["react", "node"]
  },
  "include": [
    "**/*.ts",
    "**/*.mts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src/types/**/*.d.ts",
    "src/@types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
