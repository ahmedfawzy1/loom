NODE_ENV="development"
PORT="4000"

# Same database the @loom/database package points at — `pnpm infra:up` starts it on 5435.
CMS_DATABASE_URL="postgresql://postgres:password@localhost:5435/loom?schema=public"

# Media library. These defaults point at the MinIO container `pnpm infra:up` starts, so uploads
# work locally without AWS credentials. In production, unset S3_ENDPOINT to reach real S3 and
# replace every value below.
S3_ENDPOINT="http://localhost:9010"
S3_BUCKET="loom-media"
S3_REGION="us-east-1"
S3_PUBLIC_URL="http://localhost:9010/loom-media"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"

# DeepL. Free-tier keys end in ":fx" and are auto-routed to api-free.
DEEPL_API_KEY="REPLACE_ME"
# Optional. Overrides the DeepL host picked from the key (api-free for ":fx" keys) — a proxy, or a
# stand-in server when testing locally without spending characters.
# DEEPL_API_URL="http://localhost:4100"
